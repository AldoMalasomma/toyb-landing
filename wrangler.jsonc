{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toyb-landing-workers",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      "binding": "TOYB_RATE_LIMIT_KV",
      "id": "b927be093ccd4f888e78d34ee966fb42",
    },
  ],
}
